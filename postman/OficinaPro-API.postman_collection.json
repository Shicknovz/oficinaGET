{
  "info": {
    "name": "OficinaPro API",
    "description": "Colecao de testes da API OficinaPro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3333" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "" },
    { "key": "clienteId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('API online', function () { pm.response.to.have.status(200); });",
          "pm.test('Banco conectado', function () { pm.expect(pm.response.json().database).to.eql('ok'); });"
        ] }
      }]
    },
    {
      "name": "Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario Postman\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Usuario criado', function () { pm.response.to.have.status(201); });",
          "var body = pm.response.json();",
          "pm.collectionVariables.set('token', body.token);",
          "pm.collectionVariables.set('email', body.usuario.email);"
        ] }
      }]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Login realizado', function () { pm.response.to.have.status(200); });",
          "pm.collectionVariables.set('token', pm.response.json().token);"
        ] }
      }]
    },
    {
      "name": "Criar cliente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"telefone\": \"61999999999\",\n  \"email\": \"cliente@example.com\"\n}"
        },
        "url": "{{baseUrl}}/clientes"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Cliente criado', function () { pm.response.to.have.status(201); });",
          "pm.collectionVariables.set('clienteId', pm.response.json().id);"
        ] }
      }]
    },
    {
      "name": "GETs protegidos",
      "item": [
        { "name": "Listar clientes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/clientes" } },
        { "name": "Listar veiculos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/veiculos" } },
        { "name": "Listar ordens", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/ordens" } },
        { "name": "Listar agendamentos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/agendamentos" } },
        { "name": "Listar pecas", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/pecas" } },
        { "name": "Listar financeiro", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/financeiro" } }
      ]
    }
  ]
}
